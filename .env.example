# --- Data sources ---
SEC_USER_AGENT="Your Name (you@example.com)"
FRED_API_KEY=

# --- LLM (OpenRouter, OpenAI-compatible) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# One strong mid-tier model serves actor, critic, and synthetic-query generation.
ACTOR_MODEL=meta-llama/llama-3.3-70b-instruct
CRITIC_MODEL=meta-llama/llama-3.3-70b-instruct
# Prompt A/B testing: pick a registered prompt version (see frag/rag/prompts.py).
# Unset -> the pinned default (v1); the version is logged as an MLflow param.
ACTOR_PROMPT_VERSION=1
CRITIC_PROMPT_VERSION=1
# Constrain generation to the Pydantic response schema (json_schema response
# format). Off by default; provider support varies, so enable per model.
LLM_STRUCTURED_OUTPUT=off
# Optional LLM input-guard classifier on top of the deterministic screen. Off by default.
INPUT_GUARD_LLM=off
# Agent tool-loop (Phase 7): cheap MoE default (only ~3B active); A/B via AGENT_MODEL.
AGENT_MODEL=qwen/qwen3-30b-a3b
AGENT_MAX_TURNS=6
AGENT_MAX_TOOL_CALLS=8
# Synthetic-query generation for training-pair mining (Phase 3).
PAIRGEN_MODEL=meta-llama/llama-3.3-70b-instruct
# Schema-guided KG entity/covenant extraction (Phase 6).
EXTRACT_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_TEMPERATURE=0
# Transient-failure retry (429/5xx, honouring Retry-After); auth errors fail fast.
OPENROUTER_MAX_RETRIES=4
OPENROUTER_RETRY_BASE_DELAY=2

# --- Generation / risk gate ---
TOP_K=8
# The critic is an optional risk gate, off by default; set CRITIC=on to enable it.
CRITIC=off
CRITIC_MIN_SCORE=0.8

# --- Retrieval / chunking ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHUNK_SIZE=600
CHUNK_OVERLAP=100
CHUNK_STRATEGY=window
RETRIEVAL_MODE=hybrid
# HNSW accuracy-for-latency knobs (higher ef_search -> nearer exact recall).
HNSW_ENGINE=lucene
HNSW_EF_SEARCH=256
HNSW_EF_CONSTRUCTION=256
HNSW_M=16
# Reranker stage (Phase 4): off | on, with an optional trained-model path.
RERANK=off

# --- Vector store (Qdrant until Phase 2, then OpenSearch) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=sec_filings

# --- AWS data plane (Phase 2; free-tier) ---
AWS_PROFILE=ninefin
AWS_REGION=eu-north-1
# S3_BUCKET=
# OPENSEARCH_ENDPOINT=
