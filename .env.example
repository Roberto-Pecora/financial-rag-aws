# --- Data sources ---
SEC_USER_AGENT="Your Name (you@example.com)"
FRED_API_KEY=

# --- LLM (OpenRouter, OpenAI-compatible) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# One strong mid-tier model serves actor, critic, and synthetic-query generation.
ACTOR_MODEL=meta-llama/llama-3.3-70b-instruct
CRITIC_MODEL=meta-llama/llama-3.3-70b-instruct
# Synthetic-query generation for training-pair mining (Phase 3).
PAIRGEN_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_TEMPERATURE=0

# --- Generation / risk gate ---
TOP_K=8
# The critic is an optional risk gate, off by default; set CRITIC=on to enable it.
CRITIC=off
CRITIC_MIN_SCORE=0.8

# --- Retrieval / chunking ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHUNK_SIZE=600
CHUNK_OVERLAP=100
CHUNK_STRATEGY=window
RETRIEVAL_MODE=hybrid
# Reranker stage (Phase 4): off | on, with an optional trained-model path.
RERANK=off

# --- Vector store (Qdrant until Phase 2, then OpenSearch) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=sec_filings

# --- AWS data plane (Phase 2; free-tier) ---
AWS_PROFILE=ninefin
AWS_REGION=eu-north-1
# S3_BUCKET=
# OPENSEARCH_ENDPOINT=
